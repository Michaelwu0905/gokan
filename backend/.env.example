# Gokan API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# Moonshot Kimi API (AI对话)
# Get from: https://platform.moonshot.cn/
MOONSHOT_API_KEY=your_moonshot_api_key_here

# OpenAI Whisper API (语音转文字)
# Get from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Azure TTS API (语音合成)
# Get from: https://azure.microsoft.com/en-us/services/cognitive-services/text-to-speech/
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_TTS_REGION=japaneast
AZURE_TTS_VOICE=ja-JP-NanamiNeural

# 阿里云语音服务（国内推荐）
# 替代 OpenAI Whisper + Azure TTS
# Get from: https://www.aliyun.com/product/nls
# 语音识别 + 语音合成一体化
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_APP_KEY=your_aliyun_nls_app_key
# 日语声音选项: xiaoyun(日语女声), xiaogang(日语男声)
ALIYUN_TTS_VOICE=xiaoyun

# Application Settings
DEBUG=false
LOG_LEVEL=info
# 语音服务提供商: aliyun(国内), openai+azure(国外), virtual(虚拟)
AUDIO_PROVIDER=aliyun
